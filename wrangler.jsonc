{
  // AdsBookCMS — product template.
  //
  // This file is a TEMPLATE, not a deployment. One install = one Worker = one
  // store. It is deployable as-is through the "Deploy to Cloudflare" button
  // (README, ADR-026): Cloudflare copies the repository into the operator's own
  // account, creates the D1, KV and R2 resources below, replaces the all-zero
  // ids with the real ones, and deploys. The operator then opens the Worker's
  // URL and finishes in the /install wizard.
  //
  // The CLI path (INSTALLATION.md) creates the same resources by hand:
  //   npx wrangler d1 create <store>-d1
  //   npx wrangler kv namespace create SESSION
  //   npx wrangler r2 bucket create <store>-assets
  // then pastes the printed ids below.
  //
  // The all-zero ids are the one thing that must never deploy: they are what a
  // merge from the product looks like inside an install, and the deploy
  // preflight refuses them (src/lib/deploy-preflight.ts).
  //
  // Binding NAMES are fixed across every install — OMS_DB, SESSION,
  // ASSET_BUCKET, AI, ASSETS — because the application resolves them by name.
  // Only the resource names and ids differ.
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Unique within the Cloudflare account. The button lets the operator rename
  // it; the default is a real, deployable name rather than a placeholder.
  "name": "adsbookcms",
  "main": "./src/worker.ts",


  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Run the Worker beside its D1, not beside the visitor. A page makes several
  // sequential D1 reads, and Cloudflare serves part of Indonesian traffic (and
  // all of PageSpeed Insights) from US colos: there each read crossed the
  // Pacific, 3.7-6 s to the first byte on page.revenleather.com against 0.5 s
  // from SIN. Static assets still serve from the nearest colo. Cloudflare needs
  // up to 15 minutes of multi-location traffic to decide (ADR-030).
  "placement": {
    "mode": "smart"
  },

  // The one secret a store cannot run without, and the only one the Deploy
  // button asks for (.dev.vars.example). `wrangler deploy` refuses a Worker
  // that lacks it. Everything else is optional:
  //   AUTH_SECRET — generated by the Worker itself into D1 when unset (ADR-026);
  //   provider keys (Mengantar, AutoLaris, Meta) — saved from /admin, D1 first.
  "secrets": {
    "required": [
      "INSTALL_TOKEN"
    ]
  },

  // On, so a freshly deployed store has an address to open /install at before
  // any domain exists. Once a custom domain is attached (Workers → Settings →
  // Domains & Routes), the workers.dev copy answers `X-Robots-Tag: noindex` and
  // canonical tags point at the store's own URL. An install may set this to
  // false in its own wrangler.jsonc once its domain is live.
  "workers_dev": true,
  // Hourly evaluation catches a stalled conversion outbox even when no operator
  // opens the dashboard. Alert transitions are deduplicated in the install's KV.
  "triggers": {
    "crons": ["7 * * * *"]
  },


  "assets": {
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "00000000000000000000000000000000"
    }
  ],
  "d1_databases": [
    {
      "binding": "OMS_DB",
      "database_name": "adsbookcms-d1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "adsbookcms-assets"
    }
  ],
  "ai": {
    "binding": "AI"
  },

  // Without this, Workers Logs are off and the ~76 labelled console.error
  // calls in src/ are unqueryable — a failing install cannot be diagnosed
  // after the fact. See OBSERVABILITY.md.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // No `routes`: the store's domain is attached in the dashboard (Workers →
  // Settings → Domains & Routes). Wrangler leaves dashboard-managed routes
  // alone when this key is absent; declaring one here would replace them on
  // every deploy, and a placeholder domain would fail the first one.

  // These are read at BUILD time through import.meta.env, not at runtime, so a
  // change here only takes effect after `npm run build`. Redeploying an already
  // built bundle with new vars changes nothing. See ARCHITECTURE.md §5.
  "vars": {
    "PUBLIC_SITE_NAME": "Your Store",
    "PUBLIC_SITE_URL": "https://example.com",
    // Deliberately empty, like the tagline below. A placeholder here becomes
    // the meta description Google prints under the store, and the second half
    // of the home page <title>.
    "PUBLIC_SITE_DESCRIPTION": "",
    // Deliberately empty. A non-empty default here becomes the second half of
    // every unconfigured store's <title>, which is how a fresh install came to
    // announce itself as "Toko Anda — Belum Dikonfigurasi".
    "PUBLIC_SITE_TAGLINE": "",
    // Brand reported to Google and Meta for a product with none of its own.
    // Empty means the store name.
    "PUBLIC_DEFAULT_BRAND": "",
    "PUBLIC_ADMIN_NAME": "AdsBookCMS Admin",
    "PUBLIC_EMBED_ALLOWED_ORIGINS": "",

    // Root-relative or absolute. Replace the placeholder wordmark in
    // public/images/ with the store's own brand assets.
    "PUBLIC_SITE_LOGO": "/images/adsbook-mark.webp",

    // Must match #rrggbb or the code falls back to its own default.
    "PUBLIC_SITE_THEME_COLOR": "#111111",

    // Drives <html lang> and the Open Graph locale.
    "PUBLIC_SITE_LOCALE": "id-ID",

    // compact-market. wide-catalog was retired in ADR-018 and migration 0044;
    // an unknown value takes the home page to its unavailable state (503).
    "PUBLIC_STOREFRONT_TEMPLATE": "compact-market",

    // Provinces excluded from cash on delivery, comma separated, lowercase.
    // This is the shipped Indonesian default; adjust per store.
    "PUBLIC_COD_DISABLED_PROVINCES": "papua,papua barat,papua barat daya,papua tengah,papua pegunungan,papua selatan,maluku,maluku utara,nusa tenggara timur,kalimantan utara,sulawesi barat,gorontalo,kepulauan riau,aceh,bengkulu"
  }
}
