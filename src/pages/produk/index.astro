---
import PageIntro from '../../components/storefront/shared/PageIntro.astro';
import ProductListItem from '../../components/storefront/shared/ProductListItem.astro';
import Icon from '../../components/storefront/shared/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatIdr } from '../../lib/format-idr';
import { getStorefrontProducts } from '../../lib/catalog';

const products = await getStorefrontProducts(Astro.locals);
const INITIAL_COUNT = 10;
---

<BaseLayout
  title={`Produk - ${Astro.locals.tenant.name}`}
  description={`Pilih produk ${Astro.locals.tenant.name}, lihat varian dan harga sebelum memesan.`}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Produk', url: '/produk' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-white text-[#111111]">
    <PageIntro
      badge="Semua Produk"
      title="Semua produk"
      description={products.length > 0
        ? `${products.length} produk dari ${Astro.locals.tenant.name}. Pilih untuk melihat varian dan memesan.`
        : `Produk ${Astro.locals.tenant.name} akan tampil di sini.`}
      breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Produk' }]}
    />

    <section aria-label="Daftar produk" class="px-4 pb-8 pt-4">
      {products.length > 0 ? (
        <>
          <div class="grid grid-cols-2 gap-x-3 gap-y-5" id="product-grid">
            {products.map((product, index) => (
              <div class={`product-card-item ${index >= INITIAL_COUNT ? 'hidden' : ''}`} data-index={index}>
                {/* Two rows, not one: at 390x844 the second row is fully
                    visible, and a throttled trace on the live store picked
                    card #3 as the LCP element — still lazy under index < 2. */}
                <ProductListItem product={product} formatPrice={formatIdr} eager={index < 4} />
              </div>
            ))}
          </div>

          {products.length > INITIAL_COUNT && (
            <div class="mt-8 flex flex-col items-center gap-3" id="load-more-container">
              <p class="text-xs text-[#767676]">
                Menampilkan <span id="visible-count" class="font-semibold text-[#111111]">{Math.min(INITIAL_COUNT, products.length)}</span> dari <span id="total-count" class="font-semibold text-[#111111]">{products.length}</span> produk
              </p>
              <button
                id="load-more-btn"
                type="button"
                class="inline-flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-full border border-[#E5E5E5] bg-white px-6 text-sm font-semibold text-[#111111] transition-colors hover:border-[#111111] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111]"
              >
                <span>Lihat produk lainnya</span>
                <Icon name="lucide:chevron-down" class="h-4 w-4" aria-hidden="true" />
              </button>
            </div>
          )}
        </>
      ) : (
        <div class="rounded-2xl bg-[#F3F3F3] px-5 py-10 text-center">
          <h2 class="text-lg font-semibold text-[#111111]">Katalog sedang disiapkan</h2>
          <p class="mt-2 text-sm leading-6 text-[#555555]">Produk akan muncul setelah konten dan varian diterbitkan.</p>
        </div>
      )}
    </section>
  </main>

  <script>
    const INITIAL_COUNT = 10;
    const STEP = 10;
    let visibleCount = INITIAL_COUNT;

    const items = document.querySelectorAll<HTMLElement>('.product-card-item');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const visibleCountEl = document.getElementById('visible-count');

    if (loadMoreBtn && items.length > 0) {
      loadMoreBtn.addEventListener('click', () => {
        const nextCount = Math.min(visibleCount + STEP, items.length);
        for (let i = visibleCount; i < nextCount; i++) {
          if (items[i]) {
            items[i].classList.remove('hidden');
          }
        }
        visibleCount = nextCount;
        if (visibleCountEl) {
          visibleCountEl.textContent = String(visibleCount);
        }
        if (visibleCount >= items.length) {
          loadMoreBtn.classList.add('hidden');
        }
      });
    }
  </script>
</BaseLayout>
