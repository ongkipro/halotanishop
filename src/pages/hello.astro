---
import '../styles/admin.css';
import {
  BOOTSTRAP_FALLBACK_PASSWORD,
  DEFAULT_ADMIN_PASSWORD_HASH,
  DEFAULT_ADMIN_USERNAME,
  getAdminCredential,
  isDefaultAdminCredential,
  normalizeAdminUsername,
  verifyAdminLoginPassword,
} from '../lib/admin-credentials';
import {
  SESSION_COOKIE_NAME,
  secureEqual,
  shouldSecureSessionCookie,
  signJwt,
  verifyPasswordHash,
} from '../lib/auth';
import { storeAdminSession } from '../lib/admin-session';
import { resolveAuthSecret } from '../lib/auth-secret';
import { getEnvValue, getRuntimeEnv } from '../lib/env';
import {
  checkAdminLoginRateLimit,
  spendAdminLoginAttempt,
  clearAdminLoginFailures,
  getClientIp,
  recordAdminLoginFailure,
} from '../lib/rate-limit';

import { CMS_VERSION } from '../lib/version';

export const prerender = false;

let errorMessage = '';
let submittedUsername = '';
let focusPassword = false;

const env = getRuntimeEnv(Astro.locals);
const database = env?.OMS_DB as D1Database | undefined;
const bootstrapAdminPassword = getEnvValue('BOOTSTRAP_ADMIN_PASSWORD', env);

// The middleware's cross-site guard only covers /api/admin/*, and this form
// posts to itself — so the login POST needs its own origin check. Without it a
// third-party page can silently log an admin into an attacker's session.
const loginOrigin = Astro.request.headers.get('origin');
const loginFetchSite = Astro.request.headers.get('sec-fetch-site');
const crossSiteLogin =
  (loginOrigin !== null && loginOrigin !== Astro.url.origin) ||
  loginFetchSite === 'cross-site';

if (Astro.request.method === 'POST' && crossSiteLogin) {
  Astro.response.status = 403;
  errorMessage = 'Permintaan login ditolak karena berasal dari domain lain.';
} else if (Astro.request.method === 'POST') {
  const authSecret = await resolveAuthSecret(env, database);
  const clientIp = getClientIp(Astro.request.headers);

  try {
    if (!database || authSecret.length < 32) {
      Astro.response.status = 503;
      errorMessage = 'Login admin belum dikonfigurasi di server.';
    } else {
      const data = await Astro.request.formData();
      const username = normalizeAdminUsername(data.get('username'));
      submittedUsername = username;
      const password = String(data.get('password') || '').slice(0, 1024);

      // LOGIN-19. Checked before the credential is even looked up, so the limit
      // behaves identically for a username that exists and one that does not —
      // otherwise the rate limiter itself answers the question the error message
      // refuses to. Nothing is spent here; only a failure is recorded, below.
      // The wave brake first: spent atomically by every attempt, so parallel
      // guesses cannot all slip past the peek below (see spendAdminLoginAttempt).
      const wave = await spendAdminLoginAttempt(database, username, clientIp);
      const attempts = wave.allowed
        ? await checkAdminLoginRateLimit(database, username, clientIp)
        : wave;
      if (!attempts.allowed) {
        Astro.response.status = 429;
        Astro.response.headers.set(
          'retry-after',
          String(Math.max(1, Math.ceil((attempts.resetAt - Date.now()) / 1000))),
        );
        errorMessage = 'Terlalu banyak percobaan login. Coba lagi dalam beberapa menit.';
      } else {
        const credential = await getAdminCredential(database, username);

        // LOGIN-13. Every branch here must cost the same. Verifying a rotated
        // password is one PBKDF2 pass at 100k iterations; the seeded credential
        // is a digest compare, and an unknown username used to cost nothing at
        // all — so those two run a discarded verification against the seeded
        // hash. Without it a fast 401 means "no such operator" and a slow one
        // means "that one exists", which is the fact the message withholds.
        const needsWorkFloor = credential === null || isDefaultAdminCredential(credential);
        const [usernameMatches, passwordMatches] = await Promise.all([
          credential ? secureEqual(username, credential.username) : Promise.resolve(false),
          credential
            ? verifyAdminLoginPassword(password, credential, bootstrapAdminPassword)
            : Promise.resolve(false),
          needsWorkFloor
            ? verifyPasswordHash(password, DEFAULT_ADMIN_PASSWORD_HASH)
            : Promise.resolve(false),
        ]);

        if (credential && usernameMatches && passwordMatches) {
          const { token, session } = await signJwt({ username: credential.username, role: credential.role }, authSecret);
          await Promise.all([
            storeAdminSession(database, session, credential),
            clearAdminLoginFailures(database, username, clientIp),
          ]);
          Astro.cookies.set(SESSION_COOKIE_NAME, token, {
            path: '/',
            httpOnly: true,
            secure: shouldSecureSessionCookie(Astro.url),
            sameSite: 'lax',
            maxAge: 60 * 60 * 24,
          });
          return Astro.redirect(credential.mustChangePassword ? '/admin/profile' : '/admin/dashboard');
        }

        await recordAdminLoginFailure(database, username, clientIp);
        Astro.response.status = 401;
        focusPassword = true;
        errorMessage = 'Username atau password salah.';
      }
    }
  } catch (error) {
    console.error('admin-login', error);
    Astro.response.status = 500;
    errorMessage = 'Terjadi kesalahan sistem login.';
  }
}

/**
 * LOGIN-6. The seeded credential is announced only while it is the credential
 * that actually opens this install: the stored row is still the seeded default
 * *and* no BOOTSTRAP_ADMIN_PASSWORD is configured. Once the operator rotates,
 * the hash changes and this goes quiet on its own. Where a bootstrap password
 * is configured the default never opened anything (LOGIN-2), so announcing it
 * would be both false and a free hint about the account name.
 */
let showsDefaultCredential = false;
if (database && !bootstrapAdminPassword) {
  try {
    const seeded = await getAdminCredential(database, DEFAULT_ADMIN_USERNAME);
    showsDefaultCredential = seeded !== null && isDefaultAdminCredential(seeded);
  } catch (error) {
    // A database that cannot answer is not an install we can vouch for; say nothing.
    console.error('admin-login-default-notice', error);
  }
}
---

<!DOCTYPE html>
<html lang={Astro.locals.tenant.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Login AdsBookCMS - {Astro.locals.tenant.adminName}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <!-- LOGIN-18: no third-party asset. This page loaded a Google Fonts
         stylesheet for a family it never applied, which told Google the address
         of every operator opening the admin and bought nothing back. -->
  </head>
  <body class="admin-login-page bg-slate-50 text-slate-900 antialiased selection:bg-blue-200 selection:text-blue-900">
    <main class="admin-login-stage" aria-labelledby="loginTitle">
      <!-- Left Brand Panel (Desktop) -->
      <div class="admin-login-brand relative isolate hidden overflow-hidden lg:flex flex-col justify-center bg-slate-950 p-10 text-white xl:p-14">
        <!-- Ornament: a dot grid that fades toward the edges. Decorative only. -->
        <div class="login-brand-grid" aria-hidden="true"></div>
        <!-- A joke more than a tip jar, centred and alone in the panel: the CMS
             and its hosting are free, the developer's coffee is not. The
             image is the code itself, rebuilt as vector modules from the
             merchant's QRIS print (version 9, 53 modules, finder and timing
             patterns checked, payload identical to the print); the corner frame pulses outside the code so it
             never gets in a phone's way, and stops under reduced motion.
             Lazy: the panel is desktop-only, and a phone never fetches it. -->
        <section class="login-qris" aria-labelledby="loginQrisTitle">
          <div class="login-qris-frame">
            <!-- Signal waves leaving the code: the background moves, and it
                 moves outward from the QR, so the eye lands on it. Behind the
                 white card, never over the modules. -->
            <span class="login-qris-waves" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="login-qris-corner" aria-hidden="true"></span>
            <img
              src="/images/qris-dukung-adsbookcms.svg"
              alt="QRIS ONGKI COLLECTION untuk mendukung AdsBookCMS"
              width="560"
              height="560"
              loading="lazy"
              decoding="async"
              class="login-qris-image"
            />
          </div>
          <div class="login-qris-copy">
            <h2 id="loginQrisTitle" class="login-qris-title"><span class="block">CMS <span class="login-gratis">GRATIS</span>.</span> <span class="block">Server <span class="login-gratis login-gratis-2">GRATIS</span>.</span></h2>
            <p class="login-qris-body">Kopi developernya yang belum. Boleh dong ditraktir? Hehehe.</p>
            <figure class="login-qris-quote">
              <blockquote>&ldquo;Satu kopi, satu bug minggat.&rdquo;</blockquote>
              <figcaption>by ongki.pro</figcaption>
            </figure>
            <p class="login-qris-note">QRIS a.n. ONGKI COLLECTION</p>
          </div>
        </section>
      </div>

      <!-- Right Form Panel -->
      <!-- One screen, no scroll, on a phone and on a desktop: the form centred,
           a short footer pinned to the bottom of the same column. -->
      <div class="admin-login-form-wrapper">
        <div class="admin-login-card">
          <div class="admin-login-header text-center lg:text-left">
            <!-- The wordmark: "Ads" in the brand blue, "Book" in ink - the two
                 halves of the name - and "CMS" as a small tracked tag after a
                 hairline. One accessible name, "AdsBookCMS". -->
            <!-- The wordmark leads back to the store's homepage, on a phone and
                 on a desktop alike: an operator who reached the login by mistake,
                 or who wants to see the shop, has one obvious way out. -->
            <h1 id="loginTitle" class="login-wordmark">
              <a href="/" class="login-wordmark-link" aria-label={`AdsBookCMS, kembali ke beranda ${Astro.locals.tenant.name}`} title={`Ke beranda ${Astro.locals.tenant.name}`}>
                <img src="/images/adsbook-icon.svg" alt="" width="28" height="28" class="size-7 shrink-0" />
                <span aria-hidden="true" class="login-wordmark-name"><span class="text-[#2563EB]">Ads</span>Book</span>
                <span aria-hidden="true" class="login-wordmark-tag">CMS</span>
              </a>
            </h1>
          </div>
          <div class="admin-login-form-content">
        {errorMessage && (
          <div id="loginError" class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4" role="alert" aria-live="assertive">
            <div class="flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 flex-shrink-0 text-rose-600" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
              </svg>
              <p class="text-sm font-normal leading-relaxed text-rose-800">{errorMessage}</p>
            </div>
          </div>
        )}

        {showsDefaultCredential && (
          <div id="defaultCredentialNotice" class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
            <div class="flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-600" aria-hidden="true">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
              </svg>
              <div>
                <p class="font-semibold text-amber-950">Akses awal perlu diamankan</p>
                <p class="mt-1.5 leading-relaxed">Gunakan username <strong class="font-semibold text-amber-950">{DEFAULT_ADMIN_USERNAME}</strong> dan password <strong class="font-semibold text-amber-950">{BOOTSTRAP_FALLBACK_PASSWORD}</strong>. Ganti password setelah masuk untuk membuka operasional.</p>
              </div>
            </div>
          </div>
        )}

        <form id="loginForm" method="POST" class="space-y-4" aria-busy="false" aria-describedby={[errorMessage && 'loginError', showsDefaultCredential && 'defaultCredentialNotice'].filter(Boolean).join(' ') || undefined}>
          <div class="space-y-2">
            <label for="username" class="text-sm font-semibold text-slate-900">Username operator</label>
            <input id="username" type="text" name="username" required autocomplete="username" autofocus={!focusPassword} value={submittedUsername} placeholder="Username Anda" class="admin-input-flat" spellcheck="false" />
          </div>

          <div class="space-y-2">
            <label for="password" class="text-sm font-semibold text-slate-900">Password</label>
            <div class="relative flex items-center">
              <input id="password" type="password" name="password" required autocomplete="current-password" autofocus={focusPassword} placeholder="Masukkan password" class="admin-input-flat pr-20" />
              <button id="togglePassword" type="button" class="absolute right-1 flex items-center justify-center rounded px-3 text-sm font-normal text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-1" aria-controls="password" aria-label="Tampilkan password" aria-pressed="false">Lihat</button>
            </div>
          </div>

          <button id="loginSubmit" type="submit" class="mt-1 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-[#2563EB] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#1D4ED8] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2563EB] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:bg-[#1D4ED8] disabled:text-white/80">
            Masuk
          </button>
          <p id="loginStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </div>
        </div>
        <footer class="admin-login-foot">
          <p class="font-mono text-slate-400">AdsBookCMS v{CMS_VERSION.version}</p>
        </footer>
      <script>
        const form = document.getElementById('loginForm') as HTMLFormElement | null;
        const submit = document.getElementById('loginSubmit') as HTMLButtonElement | null;
        const password = document.getElementById('password') as HTMLInputElement | null;
        const toggle = document.getElementById('togglePassword') as HTMLButtonElement | null;
        const status = document.getElementById('loginStatus');
        const submitLabel = submit?.textContent?.trim() || 'Masuk Dashboard';
        let pending = false;

        // A page restored from the back/forward cache keeps the DOM it was
        // unloaded with. Without this the operator comes back to a permanently
        // disabled button still reading "Memverifikasi…" and cannot log in.
        window.addEventListener('pageshow', (event) => {
          if (!event.persisted || !submit) return;
          pending = false;
          form?.setAttribute('aria-busy', 'false');
          submit.disabled = false;
          submit.textContent = submitLabel;
          if (status) status.textContent = '';
        });

        form?.addEventListener('submit', (event) => {
          if (pending) {
            event.preventDefault();
            return;
          }
          if (!form.checkValidity() || !submit) return;
          pending = true;
          form.setAttribute('aria-busy', 'true');
          submit.disabled = true;
          submit.innerHTML = '<svg class="mr-2 h-4 w-4 animate-spin text-white/80 motion-reduce:animate-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Memverifikasi&hellip;';
          if (status) status.textContent = 'Memverifikasi kredensial admin.';
        });

        toggle?.addEventListener('click', () => {
          if (!password) return;
          const visible = password.type === 'text';
          password.type = visible ? 'password' : 'text';
          toggle.textContent = visible ? 'Lihat' : 'Sembunyikan';
          toggle.setAttribute('aria-label', visible ? 'Tampilkan password' : 'Sembunyikan password');
          toggle.setAttribute('aria-pressed', String(!visible));
        });
      </script>
      </div>
    </main>
  </body>
</html>
