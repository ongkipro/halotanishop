---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
export const prerender = false;
import NativeSelect from '../../../components/ui/NativeSelect.astro';
---

<AdminLayout title="Toko & customer service" activeMenu="settings">
  <div class="space-y-6">
    <AdminPageHeader
      title="Toko & customer service"
      description="Informasi merchant dan kontak yang dipakai dalam komunikasi pelanggan."
      backHref="/admin/settings"
      backLabel="Pengaturan"
    />
    <div id="storeLoading" class="h-60 animate-pulse rounded-xl bg-slate-100" role="status" aria-live="polite" aria-busy="true" aria-atomic="true"><span class="sr-only">Memuat profil store.</span></div>
    <div id="storeError" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-800" role="alert" aria-live="assertive"></div>
    <form id="storeForm" class="hidden rounded-xl border border-slate-200 bg-white shadow-sm" novalidate aria-busy="false">
      <div class="grid grid-cols-1 gap-5 p-5 md:grid-cols-2 md:p-6">
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Nama store</span>
          <input id="storeName" required maxlength="120" autocomplete="organization" class="admin-input-flat" />
        </label>
        <div class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">WhatsApp customer service</span>
          <p id="supportWhatsapp" class="admin-input-flat flex items-center font-mono text-slate-700">—</p>
          <span class="mt-1.5 block text-xs text-slate-500">Nomor pertama yang aktif. <a href="/admin/settings/whatsapp" class="font-semibold text-slate-900 underline underline-offset-2">Kelola nomor WhatsApp</a> untuk menambah atau membagi pembeli ke beberapa CS.</span>
        </div>
        <label class="flex items-start gap-2.5">
          <input id="thanksWhatsappRedirect" type="checkbox" class="mt-0.5 size-4 shrink-0" />
          <span>
            <span class="block text-xs font-semibold text-slate-700">Arahkan pembeli COD ke WhatsApp setelah order</span>
            <span class="mt-0.5 block text-xs text-slate-500">Halaman terima kasih membuka chat ke nomor CS (dibagi rata bila lebih dari satu) dalam ±3 detik, setelah pixel Purchase terkirim, dengan pesan berisi nomor invoice, nama, dan produk. Pembeli QRIS/VA/transfer tetap di halaman pembayaran.</span>
          </span>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Email customer service</span>
          <input id="supportEmail" type="email" inputmode="email" autocomplete="email" maxlength="160" placeholder="cs@tokosaya.com" class="admin-input-flat" />
          <span class="mt-1.5 block text-xs text-slate-500">Opsional. Tampil di halaman Kontak, Kebijakan Privasi, Pengiriman &amp; Retur, dan Syarat &amp; Ketentuan.</span>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Alamat usaha</span>
          <textarea id="businessAddress" maxlength="300" rows="2" autocomplete="street-address" class="admin-input-flat min-h-20 py-2"></textarea>
          <span class="mt-1.5 block text-xs text-slate-500">Opsional. Alamat pengelola toko untuk halaman Kontak dan kebijakan. Kosongkan bila tidak ingin dipublikasikan.</span>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Alamat storefront</span>
          <input id="storeSiteUrl" inputmode="url" maxlength="200" placeholder="https://tokosaya.com" class="admin-input-flat" />
          <span class="mt-1.5 block text-xs text-slate-500">Harus https. Dipakai untuk canonical, sitemap, dan feed katalog.</span>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Tagline</span>
          <input id="storeTagline" maxlength="120" class="admin-input-flat" />
          <span class="mt-1.5 block text-xs text-slate-500">Muncul di judul halaman storefront.</span>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Deskripsi</span>
          <input id="storeDescription" maxlength="300" class="admin-input-flat" />
          <span class="mt-1.5 block text-xs text-slate-500">Meta description bawaan dan teks Open Graph.</span>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Logo</span>
          <input id="storeLogo" maxlength="300" placeholder="/images/logo-toko.png" class="admin-input-flat" />
          <span class="mt-1.5 block text-xs text-slate-500">Kosongkan untuk menampilkan nama toko sebagai logo teks.</span>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Tampilan storefront</span>
          <NativeSelect id="storeTemplate" class="h-11 text-base md:text-sm">
            <option value="compact-market">Compact Market</option>
          </NativeSelect>
          <span class="mt-1.5 block text-xs text-slate-500">Berlaku langsung tanpa build ulang.</span>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Warna tema</span>
          <input id="storeThemeColor" maxlength="7" spellcheck="false" placeholder="#111111" pattern="#[0-9a-fA-F]{6}" class="admin-input-flat font-mono" />
          <span class="mt-1.5 block text-xs text-slate-500">Heksadesimal enam digit. Mengisi <code>&lt;meta name="theme-color"&gt;</code>, yang mewarnai bilah browser di ponsel. Kosongkan untuk memakai <code>#111111</code>.</span>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Locale</span>
          <input id="storeLocale" maxlength="10" spellcheck="false" placeholder="id-ID" pattern="[a-z]{2}(-[A-Z]{2})?" class="admin-input-flat font-mono" />
          <span class="mt-1.5 block text-xs text-slate-500">Mengisi <code>&lt;html lang&gt;</code>, <code>inLanguage</code> pada JSON-LD, dan locale Open Graph. Kosongkan untuk memakai <code>id-ID</code>.</span>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Nama panel admin</span>
          <input id="storeAdminName" maxlength="120" placeholder="AdsBookCMS Admin" class="admin-input-flat" />
          <span class="mt-1.5 block text-xs text-slate-500">Judul halaman admin dan halaman login. Tidak pernah tampil di storefront.</span>
        </label>
        <div class="block">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Konten beranda</span>
          <a
            href="/admin/content"
            class="btn-secondary w-full sm:w-auto"
          >
            Buka pengaturan konten
          </a>
          <span class="mt-1.5 block text-xs text-slate-500">
            Hero, solusi, dan bagian beranda lainnya. Halaman itu sengaja tidak ada di menu;
            sebelumnya satu-satunya jalan ke sana adalah tombol di storefront yang hilang begitu
            konten diterbitkan.
          </span>
        </div>
      </div>
      <div class="flex flex-col gap-3 border-t border-slate-200 p-4 sm:flex-row sm:items-center sm:justify-between">
        <p id="storeStatus" class="min-h-5 text-xs font-semibold text-slate-500" role="status" aria-live="polite" aria-atomic="true">Perubahan belum ada.</p>
        <button id="saveStore" type="submit" class="btn-blue w-full sm:w-auto">Simpan profil store</button>
      </div>
    </form>
    <form id="templateDefinitionForm" class="hidden rounded-xl border border-slate-200 bg-white shadow-sm" novalidate aria-busy="false">
      <div class="p-5 md:p-6">
        <h2 class="text-base font-semibold text-slate-950">Tambah template storefront</h2>
        <p class="mt-1 text-xs leading-5 text-slate-500">Susun template dari bagian yang tersedia. Konfigurasi tersimpan tidak dapat menjalankan HTML atau JavaScript.</p>
        <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2">
          <label class="block">
            <span class="mb-1.5 block text-xs font-semibold text-slate-700">ID template</span>
            <input id="templateDefinitionId" required minlength="2" maxlength="40" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="katalog-ringkas" class="admin-input-flat font-mono" />
            <span class="mt-1.5 block text-xs text-slate-500">Huruf kecil, angka, dan tanda hubung.</span>
          </label>
          <label class="block">
            <span class="mb-1.5 block text-xs font-semibold text-slate-700">Nama template</span>
            <input id="templateDefinitionName" required minlength="2" maxlength="80" placeholder="Katalog Ringkas" class="admin-input-flat" />
          </label>
          <label class="block">
            <span class="mb-1.5 block text-xs font-semibold text-slate-700">Layout</span>
            <NativeSelect id="templateDefinitionLayout" class="h-11 text-base md:text-sm">
              <option value="compact">Compact</option>
            </NativeSelect>
          </label>
          <fieldset class="block">
            <legend class="mb-1.5 text-xs font-semibold text-slate-700">Bagian halaman</legend>
            <div class="flex min-h-11 flex-wrap items-center gap-4">
              <label class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-slate-700"><input id="templateSectionHero" type="checkbox" checked class="size-4" /> Hero</label>
              <label class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-slate-700"><input type="checkbox" checked disabled class="size-4" /> Katalog</label>
              <label class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-slate-700"><input id="templateSectionProofs" type="checkbox" checked class="size-4" /> Bukti sosial</label>
            </div>
          </fieldset>
        </div>
      </div>
      <div class="flex flex-col gap-3 border-t border-slate-200 p-4 sm:flex-row sm:items-center sm:justify-between">
        <p id="templateDefinitionStatus" class="min-h-5 text-xs font-semibold text-slate-500" role="status" aria-live="polite" aria-atomic="true">Template baru belum disimpan.</p>
        <button id="saveTemplateDefinition" type="submit" class="btn-blue w-full sm:w-auto">Tambah template</button>
      </div>
    </form>
    <form id="embedOriginsForm" class="hidden rounded-xl border border-slate-200 bg-white shadow-sm" novalidate aria-busy="false">
      <div class="p-5 md:p-6">
        <h2 class="text-base font-semibold text-slate-950">Domain untuk embed checkout</h2>
        <p class="mt-1 text-xs leading-5 text-slate-500">Tentukan situs eksternal yang boleh menampilkan checkout AdsBookCMS di dalam iframe.</p>
        <label class="mt-5 block" for="embedAllowedOrigins">
          <span class="mb-1.5 block text-xs font-semibold text-slate-700">Origin HTTPS yang diizinkan</span>
          <textarea id="embedAllowedOrigins" rows="5" maxlength="7524" spellcheck="false" aria-describedby="embedOriginsHelp" placeholder="https://toko.example&#10;https://promo.toko.example:8443" class="admin-input-flat min-h-36 resize-y py-3 font-mono"></textarea>
        </label>
        <p id="embedOriginsHelp" class="mt-2 text-xs leading-5 text-slate-500">Satu origin per baris, maksimal 25. Wajib memakai <code>https://</code> dan hanya boleh berisi domain atau subdomain serta port opsional. Domain dan subdomain berbeda, jadi daftarkan keduanya bila diperlukan. Path, query, fragment, kredensial, dan wildcard tidak diterima.</p>
      </div>
      <div class="flex flex-col gap-3 border-t border-slate-200 p-4 sm:flex-row sm:items-center sm:justify-between"><p id="embedOriginsStatus" class="min-h-5 text-xs font-semibold text-slate-500" role="status" aria-live="polite" aria-atomic="true">Perubahan belum ada.</p><button id="saveEmbedOrigins" type="submit" class="btn-blue w-full sm:w-auto">Simpan domain embed</button></div>
    </form>
  </div>
  <script>
    const form = document.getElementById('storeForm') as HTMLFormElement | null;
    const name = document.getElementById('storeName') as HTMLInputElement | null;
    const phone = document.getElementById('supportWhatsapp') as HTMLElement | null;
    const thanksRedirect = document.getElementById('thanksWhatsappRedirect') as HTMLInputElement | null;
    const siteUrl = document.getElementById('storeSiteUrl') as HTMLInputElement | null;
    const supportEmail = document.getElementById('supportEmail') as HTMLInputElement | null;
    const businessAddress = document.getElementById('businessAddress') as HTMLTextAreaElement | null;
    const tagline = document.getElementById('storeTagline') as HTMLInputElement | null;
    const description = document.getElementById('storeDescription') as HTMLInputElement | null;
    const logo = document.getElementById('storeLogo') as HTMLInputElement | null;
    const template = document.getElementById('storeTemplate') as HTMLSelectElement | null;
    const themeColor = document.getElementById('storeThemeColor') as HTMLInputElement | null;
    const localeField = document.getElementById('storeLocale') as HTMLInputElement | null;
    const adminName = document.getElementById('storeAdminName') as HTMLInputElement | null;
    const save = document.getElementById('saveStore') as HTMLButtonElement | null;
    const status = document.getElementById('storeStatus');
    const loading = document.getElementById('storeLoading');
    const embedForm = document.getElementById('embedOriginsForm') as HTMLFormElement | null;
    const embedOrigins = document.getElementById('embedAllowedOrigins') as HTMLTextAreaElement | null;
    const saveEmbedOrigins = document.getElementById('saveEmbedOrigins') as HTMLButtonElement | null;
    const embedStatus = document.getElementById('embedOriginsStatus');
    const templateDefinitionForm = document.getElementById('templateDefinitionForm') as HTMLFormElement | null;
    const templateDefinitionId = document.getElementById('templateDefinitionId') as HTMLInputElement | null;
    const templateDefinitionName = document.getElementById('templateDefinitionName') as HTMLInputElement | null;
    const templateDefinitionLayout = document.getElementById('templateDefinitionLayout') as HTMLSelectElement | null;
    const templateSectionHero = document.getElementById('templateSectionHero') as HTMLInputElement | null;
    const templateSectionProofs = document.getElementById('templateSectionProofs') as HTMLInputElement | null;
    const saveTemplateDefinition = document.getElementById('saveTemplateDefinition') as HTMLButtonElement | null;
    const templateDefinitionStatus = document.getElementById('templateDefinitionStatus');
    let embedPending = false;
    let pending = false;
    let templateDefinitionPending = false;
    let runtimeTemplatesAvailable = true;

    const show = (message: string, state: 'idle' | 'success' | 'error') => {
      if (!status) return;
      status.setAttribute('role', state === 'error' ? 'alert' : 'status');
      status.setAttribute('aria-live', state === 'error' ? 'assertive' : 'polite');
      status.textContent = message;
      status.className = `min-h-5 text-xs font-semibold ${state === 'success' ? 'text-blue-700' : state === 'error' ? 'text-rose-700' : 'text-slate-500'}`;
    };
    const showEmbedStatus = (message: string, state: 'idle' | 'success' | 'error') => {
      if (!embedStatus) return;
      embedStatus.setAttribute('role', state === 'error' ? 'alert' : 'status');
      embedStatus.setAttribute('aria-live', state === 'error' ? 'assertive' : 'polite');
      embedStatus.textContent = message;
      embedStatus.className = `min-h-5 text-xs font-semibold ${state === 'success' ? 'text-blue-700' : state === 'error' ? 'text-rose-700' : 'text-slate-500'}`;
    };
    const showTemplateDefinitionStatus = (message: string, state: 'idle' | 'success' | 'error') => {
      if (!templateDefinitionStatus) return;
      templateDefinitionStatus.setAttribute('role', state === 'error' ? 'alert' : 'status');
      templateDefinitionStatus.setAttribute('aria-live', state === 'error' ? 'assertive' : 'polite');
      templateDefinitionStatus.textContent = message;
      templateDefinitionStatus.className = `min-h-5 text-xs font-semibold ${state === 'success' ? 'text-blue-700' : state === 'error' ? 'text-rose-700' : 'text-slate-500'}`;
    };

    const populateTemplateOptions = (definitions: unknown, selectedId: string) => {
      if (!template || !Array.isArray(definitions)) return;
      template.replaceChildren();
      for (const candidate of definitions) {
        if (!candidate || typeof candidate !== 'object') continue;
        const definition = candidate as { id?: unknown; name?: unknown };
        if (typeof definition.id !== 'string' || typeof definition.name !== 'string') continue;
        const option = document.createElement('option');
        option.value = definition.id;
        option.textContent = definition.name;
        template.append(option);
      }
      if (selectedId && ![...template.options].some(option => option.value === selectedId)) {
        const invalidOption = document.createElement('option');
        invalidOption.value = selectedId;
        invalidOption.textContent = `Template tidak valid (${selectedId})`;
        invalidOption.disabled = true;
        template.append(invalidOption);
      }
      template.value = selectedId || 'compact-market';
    };

    const setTemplateDefinitionPending = (next: boolean) => {
      templateDefinitionPending = next;
      if (saveTemplateDefinition) {
        saveTemplateDefinition.disabled = next || !runtimeTemplatesAvailable;
        saveTemplateDefinition.textContent = next ? 'Menambahkan…' : 'Tambah template';
      }
      templateDefinitionForm?.setAttribute('aria-busy', String(next));
    };

    const setEmbedPending = (next: boolean) => {
      embedPending = next;
      if (saveEmbedOrigins) {
        saveEmbedOrigins.disabled = next;
        saveEmbedOrigins.textContent = next ? 'Menyimpan…' : 'Simpan domain embed';
      }
      embedForm?.setAttribute('aria-busy', String(next));
    };


    const setPending = (next: boolean) => {
      pending = next;
      if (save) {
        save.disabled = next;
        save.textContent = next ? 'Menyimpan…' : 'Simpan profil store';
      }
      form?.setAttribute('aria-busy', String(next));
    };

    fetch('/api/admin/settings', { headers: { Accept: 'application/json' } }).then(async response => {
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal memuat profil store.');
      return payload.data.store;
    }).then(data => {
      if (name) name.value = data.name || '';
      if (phone) phone.textContent = data.support_whatsapp || 'Belum ada nomor';
      if (thanksRedirect) thanksRedirect.checked = data.thanks_whatsapp_redirect === true;
      if (siteUrl) siteUrl.value = data.site_url || '';
      if (supportEmail) supportEmail.value = data.support_email || '';
      if (businessAddress) businessAddress.value = data.business_address || '';
      if (tagline) tagline.value = data.tagline || '';
      if (description) description.value = data.description || '';
      if (logo) logo.value = data.logo || '';
      if (themeColor) themeColor.value = data.theme_color || '';
      if (localeField) localeField.value = data.locale || '';
      if (adminName) adminName.value = data.admin_name || '';
      populateTemplateOptions(data.storefront_templates, data.storefront_template || 'compact-market');
      if (embedOrigins) embedOrigins.value = Array.isArray(data.embed_allowed_origins) ? data.embed_allowed_origins.join('\n') : '';
      templateDefinitionForm?.classList.remove('hidden');
      runtimeTemplatesAvailable = data.storefront_templates_available !== false;
      if (data.storefront_templates_available === false) {
        if (saveTemplateDefinition) saveTemplateDefinition.disabled = true;
        showTemplateDefinitionStatus('Penyimpanan template belum tersedia. Jalankan migrasi database terbaru.', 'error');
      }
      loading?.setAttribute('aria-busy', 'false');
      loading?.classList.add('hidden');
      form?.classList.remove('hidden');
      embedForm?.classList.remove('hidden');
    }).catch(error => {
      loading?.setAttribute('aria-busy', 'false');
      loading?.classList.add('hidden');
      const box = document.getElementById('storeError');
      if (box) {
        box.textContent = error instanceof Error ? error.message : 'Gagal memuat profil store.';
        box.classList.remove('hidden');
      }
    });

    form?.addEventListener('submit', async event => {
      event.preventDefault();
      if (pending || !form.reportValidity()) return;
      setPending(true);
      show('Menyimpan profil store…', 'idle');
      try {
        const response = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save-store',
            store_name: name?.value,
            thanks_whatsapp_redirect: thanksRedirect?.checked === true,
            site_url: siteUrl?.value,
            support_email: supportEmail?.value,
            business_address: businessAddress?.value,
            store_tagline: tagline?.value,
            store_description: description?.value,
            store_logo: logo?.value,
            storefront_template: template?.value,
            theme_color: themeColor?.value,
            locale: localeField?.value,
            admin_name: adminName?.value,
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal menyimpan profil store.');
        show(payload.message || 'Profil store tersimpan.', 'success');
      } catch (error) {
        show(error instanceof Error ? error.message : 'Gagal menyimpan profil store.', 'error');
      } finally {
        setPending(false);
      }
    });

    templateDefinitionForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (templateDefinitionPending || !templateDefinitionForm.reportValidity()) return;
      setTemplateDefinitionPending(true);
      showTemplateDefinitionStatus('Menambahkan template…', 'idle');
      const definition = {
        id: templateDefinitionId?.value,
        name: templateDefinitionName?.value,
        composition: {
          layout: templateDefinitionLayout?.value,
          sections: {
            hero: Boolean(templateSectionHero?.checked),
            catalog: true,
            proofs: Boolean(templateSectionProofs?.checked),
          },
        },
      };
      try {
        const response = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'add-storefront-template',
            storefront_template_definition: definition,
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal menambahkan template.');
        populateTemplateOptions(payload.data?.storefront_templates, String(definition.id || ''));
        if (templateDefinitionId) templateDefinitionId.value = '';
        if (templateDefinitionName) templateDefinitionName.value = '';
        showTemplateDefinitionStatus('Template ditambahkan. Simpan profil store untuk memilihnya.', 'success');
      } catch (error) {
        showTemplateDefinitionStatus(error instanceof Error ? error.message : 'Gagal menambahkan template.', 'error');
      } finally {
        setTemplateDefinitionPending(false);
      }
    });


    embedForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (embedPending || !embedForm.reportValidity()) return;
      const origins = (embedOrigins?.value || '')
        .split(/\r?\n/)
        .map(value => value.trim())
        .filter(Boolean);
      setEmbedPending(true);
      showEmbedStatus('Menyimpan daftar origin embed…', 'idle');
      try {
        const response = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'save-embed-origins', embed_allowed_origins: origins }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal menyimpan daftar origin embed.');
        if (embedOrigins && Array.isArray(payload.data?.embed_allowed_origins)) {
          embedOrigins.value = payload.data.embed_allowed_origins.join('\n');
        }
        showEmbedStatus(payload.message || 'Daftar origin embed tersimpan.', 'success');
      } catch (error) {
        showEmbedStatus(error instanceof Error ? error.message : 'Gagal menyimpan daftar origin embed.', 'error');
      } finally {
        setEmbedPending(false);
      }
    });
  </script>
</AdminLayout>
