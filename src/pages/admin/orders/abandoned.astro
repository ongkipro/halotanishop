---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { AbandonedOrders } from '../../../components/admin/AbandonedOrders';

export const prerender = false;
---

<AdminLayout title="Pesanan tertinggal" activeMenu="orders">
  <div class="space-y-5">
    <AdminPageHeader
      title="Pesanan tertinggal"
      description="Follow up calon pembeli yang sudah mengisi nama dan WhatsApp, lalu lengkapi datanya ketika siap menjadi order."
    >
      <a slot="actions" href="/admin/orders" class="btn-secondary">
        Lihat order
      </a>
    </AdminPageHeader>
    <AbandonedOrders initialQuery={Astro.url.search} client:load />
  </div>
</AdminLayout>
