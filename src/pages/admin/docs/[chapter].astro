---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import DocsChapter from '../../../components/admin/docs/DocsChapter.astro';
import DocsAdminChapter from '../../../components/admin/docs/DocsAdminChapter.astro';
import { DOCS_CHAPTERS, DOCS_PARTS } from '../../../components/admin/docs/chapters';
import { BookOpen, ChevronLeft, ChevronRight } from 'lucide-react';
export const prerender = false;

// The Docs book: one chapter per page, a table of contents beside it, and the
// previous/next chapter under it. Text only (see chapters.ts).
const index = DOCS_CHAPTERS.findIndex((chapter) => chapter.slug === Astro.params.chapter);
if (index < 0) return Astro.redirect('/admin/docs/mulai', 302);
const chapter = DOCS_CHAPTERS[index];
const previous = DOCS_CHAPTERS[index - 1];
const next = DOCS_CHAPTERS[index + 1];
const numbered = DOCS_CHAPTERS.map((item, position) => ({ ...item, number: position + 1, current: item.slug === chapter.slug }));
const parts = DOCS_PARTS.map((name, part) => ({ name, items: numbered.filter((item) => item.part === part) }));
---

<AdminLayout title={`${chapter.title} · Docs`} activeMenu="docs">
  <div class="grid grid-cols-1 gap-6 xl:grid-cols-[15rem_minmax(0,1fr)] xl:gap-10">
    <!-- Table of contents: a sticky column on wide screens, a fold on narrow ones. -->
    <aside class="xl:sticky xl:top-0 xl:self-start">
      <details class="group rounded-xl border border-slate-200 bg-white xl:hidden">
        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 px-3 text-sm font-medium text-slate-900 [&::-webkit-details-marker]:hidden">
          <BookOpen className="size-4 text-slate-500" aria-hidden="true" />
          <span class="flex-1">Bab {index + 1} dari {DOCS_CHAPTERS.length} · {chapter.title}</span>
          <ChevronRight className="size-4 text-slate-400 transition-transform group-open:rotate-90" aria-hidden="true" />
        </summary>
        <nav aria-label="Daftar isi" class="border-t border-slate-100 p-1.5">
          {parts.map((group) => (
            <div class="py-1">
              <p class="px-2.5 pb-1 pt-2 text-xs font-semibold uppercase tracking-wider text-slate-400">{group.name}</p>
              <ol>
                {group.items.map((item) => (
                  <li>
                    <a href={`/admin/docs/${item.slug}`} aria-current={item.current ? 'page' : undefined} class:list={['flex min-h-11 items-center gap-2.5 rounded-lg px-2.5 text-sm', item.current ? 'bg-slate-100 font-medium text-slate-950' : 'text-slate-600 hover:bg-slate-50']}>
                      <span class="w-5 font-mono text-xs text-slate-400">{item.number}</span>{item.title}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </nav>
      </details>
      <nav aria-label="Daftar isi" class="hidden xl:block">
        <p class="flex items-center gap-2 px-2.5 text-xs font-semibold uppercase tracking-wider text-slate-500">
          <BookOpen className="size-3.5" aria-hidden="true" /> AdsBookCMS Docs
        </p>
        {parts.map((group) => (
          <div class="mt-4">
            <p class="px-2.5 text-xs font-medium text-slate-400">{group.name}</p>
            <ol class="mt-1.5 space-y-0.5 border-l border-slate-200">
              {group.items.map((item) => (
                <li>
                  <a href={`/admin/docs/${item.slug}`} aria-current={item.current ? 'page' : undefined} class:list={['-ml-px flex items-baseline gap-2.5 border-l-2 py-1.5 pl-3 pr-2 text-sm transition-colors', item.current ? 'border-slate-900 font-medium text-slate-950' : 'border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-900']}>
                    <span class="w-5 shrink-0 font-mono text-xs text-slate-400">{item.number}</span>
                    <span>{item.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </nav>
    </aside>

    <article class="min-w-0 max-w-3xl">
      <header class="border-b border-slate-200 pb-5">
        <p class="text-xs font-medium text-slate-500">{DOCS_PARTS[chapter.part]} · <span class="font-mono">Bab {index + 1} dari {DOCS_CHAPTERS.length}</span></p>
        <h2 class="mt-1 text-xl font-semibold tracking-tight text-slate-950 md:text-2xl">{chapter.title}</h2>
        <p class="mt-2 text-sm leading-6 text-slate-500">{chapter.summary}</p>
      </header>

      <div class="docs-prose pt-2">
        {chapter.part === 0
          ? <DocsAdminChapter slug={chapter.slug} />
          : <DocsChapter slug={chapter.slug} origin={Astro.url.origin} />}
      </div>

      <nav aria-label="Bab sebelumnya dan berikutnya" class="mt-10 grid grid-cols-1 gap-3 border-t border-slate-200 pt-6 sm:grid-cols-2">
        {previous ? (
          <a href={`/admin/docs/${previous.slug}`} rel="prev" class="group flex min-h-16 flex-col justify-center rounded-xl border border-slate-200 bg-white px-4 py-3 transition-colors hover:border-slate-300 hover:bg-slate-50">
            <span class="flex items-center gap-1 text-xs text-slate-500"><ChevronLeft className="size-3.5" aria-hidden="true" />Sebelumnya</span>
            <span class="mt-0.5 text-sm font-medium text-slate-900">{previous.title}</span>
          </a>
        ) : <span class="hidden sm:block" />}
        {next && (
          <a href={`/admin/docs/${next.slug}`} rel="next" class="group flex min-h-16 flex-col items-end justify-center rounded-xl border border-slate-200 bg-white px-4 py-3 text-right transition-colors hover:border-slate-300 hover:bg-slate-50">
            <span class="flex items-center gap-1 text-xs text-slate-500">Berikutnya<ChevronRight className="size-3.5" aria-hidden="true" /></span>
            <span class="mt-0.5 text-sm font-medium text-slate-900">{next.title}</span>
          </a>
        )}
      </nav>
    </article>
  </div>

  <style is:global>
    .docs-prose { color: rgb(51 65 85); font-size: 0.9375rem; line-height: 1.75; }
    .docs-prose > * + * { margin-top: 1rem; }
    .docs-prose .lead { font-size: 1rem; color: rgb(15 23 42); }
    .docs-prose h3 { margin-top: 2.25rem; font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em; color: rgb(2 6 23); }
    .docs-prose h3 + * { margin-top: 0.5rem; }
    .docs-prose a { color: rgb(29 78 216); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgb(191 219 254); }
    .docs-prose a:hover { text-decoration-color: currentColor; }
    .docs-prose ul, .docs-prose ol { padding-left: 1.25rem; }
    .docs-prose ul { list-style: disc; }
    .docs-prose ol { list-style: decimal; }
    .docs-prose li + li { margin-top: 0.375rem; }
    .docs-prose li::marker { color: rgb(148 163 184); }
    .docs-prose :not(pre) > code { border-radius: 0.25rem; background: rgb(241 245 249); padding: 0.1rem 0.3rem; font-size: 0.8125rem; color: rgb(15 23 42); overflow-wrap: anywhere; }
    .docs-prose .table-wrap { overflow-x: auto; border: 1px solid rgb(226 232 240); border-radius: 0.75rem; background: white; }
    .docs-prose table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; line-height: 1.5; }
    .docs-prose thead { background: rgb(248 250 252); }
    .docs-prose tbody tr:last-child td { border-bottom: 0; }
    /* A phone reads each table row as a small card: the first cell is its
       heading, the rest stack under it, nothing scrolls sideways. */
    @media (max-width: 639px) {
      .docs-prose table, .docs-prose tbody, .docs-prose tr, .docs-prose td { display: block; }
      .docs-prose thead { display: none; }
      .docs-prose tr { padding: 0.75rem 0.875rem; border-bottom: 1px solid rgb(241 245 249); }
      .docs-prose tbody tr:last-child { border-bottom: 0; }
      .docs-prose td { border: 0 !important; padding: 0 !important; }
      .docs-prose td + td { margin-top: 0.25rem; color: rgb(71 85 105); }
      .docs-prose td:first-child { font-weight: 500; color: rgb(15 23 42); }
    }
    .docs-prose .note { border-left: 3px solid rgb(245 158 11); background: rgb(255 251 235); border-radius: 0 0.5rem 0.5rem 0; padding: 0.75rem 1rem; font-size: 0.875rem; color: rgb(120 53 15); }
  </style>
  <script>
    document.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-docs-copy]');
      const code = button?.closest('figure')?.querySelector('code')?.textContent;
      if (!button || code == null) return;
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Tersalin';
      } catch {
        button.textContent = 'Gagal menyalin';
      }
      setTimeout(() => { button.textContent = 'Salin'; }, 1600);
    });
  </script>
</AdminLayout>
