---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import RateCheckTools from '../../components/admin/RateCheckTools';
import { getRuntimeEnv } from '../../lib/env';

export const prerender = false;

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
let warehouse: { name: string | null; origin_area_id: string | null; origin_label: string | null } | null = null;
try {
  warehouse = (await database
    ?.prepare('SELECT name, origin_area_id, origin_label FROM warehouses ORDER BY is_primary DESC, id LIMIT 1')
    .first()) ?? null;
} catch (error) {
  // The checker still works without a default origin; say so in the log.
  console.error('admin-check-warehouse', error);
}
// "Menteng, Administrasi Jakarta Pusat, Daerah Khusus Ibukota Jakarta" does not
// fit a field; the input shows district and city, the list shows the rest.
const originParts = (warehouse?.origin_label || '').split(',').map((part) => part.trim()).filter(Boolean);
const defaultOrigin = warehouse?.origin_area_id
  ? {
      id: warehouse.origin_area_id,
      label: originParts.slice(0, 2).join(', ') || warehouse.origin_area_id,
      detail: originParts.slice(2).join(', ') || undefined,
    }
  : null;
const initialPhone = Astro.url.searchParams.get('search')?.trim() || '';
---
<AdminLayout title="Cek WA & Ongkir" activeMenu="scoring">
  <div class="space-y-6">
    <AdminPageHeader
      title="Cek WA & ongkir"
      description="Riwayat retur pembeli dan perbandingan ongkir kurir."
    />
    <RateCheckTools
      client:load
      defaultOrigin={defaultOrigin}
      warehouseName={warehouse?.name || ''}
      initialPhone={initialPhone}
    />
  </div>
</AdminLayout>
