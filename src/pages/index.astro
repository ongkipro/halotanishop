---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactMarketHome from '../components/storefront/templates/CompactMarketHome.astro';
import { getStorefrontProducts } from '../lib/catalog';
import { getRuntimeEnv } from '../lib/env';
import { getTenantHomeContent } from '../lib/tenant-content';
import { resolveStorefrontTemplate } from '../lib/storefront-template';
import { dailySeed, pickDaily } from '../lib/daily-rotation';

const database = getRuntimeEnv(Astro.locals)?.OMS_DB;
const [catalog, homeResolution, templateResolution] = await Promise.all([
  getStorefrontProducts(Astro.locals),
  getTenantHomeContent(Astro.locals),
  resolveStorefrontTemplate(
    database && typeof database === 'object' ? database as D1Database : undefined,
    Astro.locals.tenant.storefrontTemplate,
  ),
]);
const products = catalog.map((product) => ({
  slug: product.slug,
  name: product.productName,
  category: product.category,
  description: product.subheadline || product.description,
  href: `/produk/${product.slug}`,
  image: product.image,
  price: product.price,
  comparePrice: product.comparePrice,
  variants: product.variants.map((variant) => ({
    label: variant.label,
    price: variant.price,
  })),
}));
const ready = homeResolution.state === 'ready' && templateResolution.state === 'ready';
const unavailable = homeResolution.state === 'unavailable' || templateResolution.state !== 'ready';
const content = homeResolution.state === 'ready' ? homeResolution.content : null;
const template = templateResolution.state === 'ready' ? templateResolution.definition : null;
if (unavailable) Astro.response.status = 503;
const homepageTitle = ready
  ? `${Astro.locals.tenant.name} — ${Astro.locals.tenant.tagline || Astro.locals.tenant.description}`
  : `Storefront ${Astro.locals.tenant.name}`;
// The hero's slides, resolved HERE rather than inside CompactMarketHome, so
// the preload below names the image the hero will actually render. When the
// operator has no slides of their own the hero borrows a daily rotation from
// the catalogue — a fallback the old `content.heroSlides[0]` preload could
// not see, which left four of the six installs' LCP image unpreloaded. The
// pick rotates daily rather than per request so visitors reuse cached bytes.
const heroSlides =
  content && content.heroSlides.length > 0
    ? content.heroSlides
    : pickDaily(products, 3, dailySeed(new Date())).map((product) => ({
        image: product.image,
        alt: product.name,
        badge: product.category,
        text: product.name,
      }));
const itemList = {
  name: `${Astro.locals.tenant.name} — Koleksi Produk pilihan`,
  items: products.map((p) => ({
    name: p.name,
    url: p.href,
    image: p.image,
    price: p.price,
    description: p.description,
  })),
};
---

<BaseLayout
  title={homepageTitle}
  description={Astro.locals.tenant.description}
  image={heroSlides[0]?.image || undefined}
  preloadImages={heroSlides[0]?.image}
  itemList={ready ? itemList : undefined}
>
  {
      unavailable || !content || !template ? (
      <section class="mx-auto flex min-h-[70vh] max-w-2xl items-center px-6 py-20 text-center">
        <div class="w-full rounded-3xl border border-slate-200 bg-white p-8 md:p-12" role="alert">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-600">Storefront tidak tersedia</p>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Halaman belum dapat ditampilkan</h1>
          <p class="mx-auto mt-4 max-w-lg text-sm leading-7 text-slate-600">
            Konfigurasi storefront sedang tidak dapat dibaca. Silakan coba lagi beberapa saat lagi.
          </p>
          <a href="/" class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 text-sm font-bold text-slate-800 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-950">
            Coba lagi
          </a>
        </div>
      </section>
    ) : (
      <CompactMarketHome content={content} products={products} heroSlides={heroSlides} sections={template.composition.sections} />
    )
  }
</BaseLayout>
