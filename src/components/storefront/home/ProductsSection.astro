---
// One card for the whole storefront. The home grid grew its own with a
// rating, a sold count and a CTA while /produk had a cleaner one; two cards
// meant two answers to the same question. The wrapper below keeps the search
// hooks the filter script reads - the card has no business knowing them.
import ProductListItem from '../shared/ProductListItem.astro';
import Icon from '../shared/Icon.astro';

interface Product {
  slug: string;
  name: string;
  category: string;
  description: string;
  href: string;
  image: string;
  price: number;
  comparePrice?: number;
  ratingValue?: number;
  reviewCount?: number;
  soldCount?: number;
  variants?: Array<{ label: string; price: number }>;
}

interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  products: Product[];
  heading: Heading;
}

const { products, heading } = Astro.props;
// Chips only when they narrow something: one category is the whole list.
const categories = [...new Set(products.map((product) => product.category).filter(Boolean))];
const showChips = categories.length > 1;
const chipClass =
  'catalog-chip inline-flex min-h-10 shrink-0 items-center rounded-full border border-[#E5E5E5] bg-white px-3.5 text-sm text-[#111111] transition-colors hover:border-[#111111] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111] aria-pressed:border-[#111111] aria-pressed:bg-[#111111] aria-pressed:text-white';

const formatPrice = (val: number) => `Rp${val.toLocaleString('id-ID')}`;
---

<section id="produk" class="px-4 pb-6 pt-8">
  <div class="mb-4">
    <h2 class="text-xl font-bold tracking-[-0.02em] text-[#111111]">{heading.title}</h2>
    {heading.description && <p class="mt-1 text-sm leading-6 text-[#555555]">{heading.description}</p>}
  </div>

  <div class="mb-4 flex flex-col gap-3" hidden={products.length === 0}>
    <div class="relative w-full">
      <input
        type="search"
        id="catalog-search"
        placeholder="Cari produk"
        aria-label="Cari produk"
        class="min-h-11 w-full rounded-full border border-[#E5E5E5] bg-[#F3F3F3] py-2.5 pl-11 pr-4 text-base text-[#111111] transition-colors placeholder:text-[#555555] focus:border-[#111111] focus:bg-white focus:outline-none"
      />
      <Icon
        name="lucide:search"
        class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#555555]"
        aria-hidden="true"
      />
    </div>
    {showChips && (
      <div role="group" aria-label="Kategori" class="catalog-chips -mx-4 flex gap-2 overflow-x-auto px-4 pb-1">
        <button type="button" class={chipClass} data-category="" aria-pressed="true">Semua</button>
        {categories.map((category) => (
          <button type="button" class={chipClass} data-category={category} aria-pressed="false">{category}</button>
        ))}
      </div>
    )}
  </div>

  {
    products.length === 0 && (
      <div class="rounded-2xl bg-[#F3F3F3] px-5 py-10 text-center">
        <p class="text-sm font-semibold text-[#111111]">Katalog sedang disiapkan</p>
        <p class="mx-auto mt-1 max-w-[26rem] text-sm leading-6 text-[#555555]">
          Produk akan tampil di sini setelah diterbitkan.
        </p>
      </div>
    )
  }

  <p id="catalog-empty" class="hidden rounded-2xl bg-[#F3F3F3] px-5 py-8 text-center text-sm text-[#555555]">
    Produk tidak ditemukan. Coba kata lain atau pilih kategori Semua.
  </p>

  <div id="product-grid" class="grid grid-cols-2 gap-x-3 gap-y-5" hidden={products.length === 0}>
    {
      products.map((product, idx) => (
        <div
          class:list={['product-card', idx >= 10 && 'hidden']}
          data-category={product.category}
          data-search={`${product.name} ${product.category} ${product.description}`.toLowerCase()}
          data-index={idx}
        >
          <ProductListItem
            product={{
              slug: product.slug,
              productName: product.name,
              heroImage: product.image,
              category: product.category,
              price: product.price,
              comparePrice: product.comparePrice,
              variants: product.variants ?? [],
            }}
            formatPrice={formatPrice}
          />
        </div>
      ))
    }
  </div>

  <div
    id="load-more-container"
    class="mt-6 flex flex-col items-center gap-3"
    hidden={products.length === 0}
  >
    <p id="catalog-status" class="text-xs text-[#555555]">
      Menampilkan <span id="product-visible-count">{Math.min(10, products.length)}</span> dari <span id="product-total-count">{products.length}</span> produk
    </p>
    {
      products.length > 10 && (
        <button
          type="button"
          id="load-more-btn"
          class="inline-flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-full border border-[#E5E5E5] bg-white px-6 text-sm font-semibold text-[#111111] transition-colors hover:border-[#111111] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111]"
        >
          <span>Lihat produk lainnya</span>
          <Icon name="lucide:chevron-down" class="h-4 w-4" aria-hidden="true" />
        </button>
      )
    }
  </div>
</section>

<script>
  function initProductCatalog() {
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;
    const loadMoreBtn = document.getElementById('load-more-btn');
    const visibleCountEl = document.getElementById('product-visible-count');
    const totalCountEl = document.getElementById('product-total-count');

    const emptyEl = document.getElementById('catalog-empty');
    const statusEl = document.getElementById('catalog-status');
    const chips = document.querySelectorAll<HTMLButtonElement>('.catalog-chip');
    let currentSearch = '';
    let currentCategory = '';
    let visibleLimit = 10;

    function filterAndRender() {
      let matchedCount = 0;
      let currentlyShown = 0;

      cards.forEach((card) => {
        const searchData = card.getAttribute('data-search') || '';
        const matchesSearch =
          (!currentSearch || searchData.includes(currentSearch)) &&
          (!currentCategory || card.getAttribute('data-category') === currentCategory);
        if (matchesSearch) matchedCount++;

        // Toggle a class rather than writing `style.display`. Showing a card
        // with `display: flex` turned the wrapper into a flex container, which
        // sizes its `<article>` to max-content instead of the grid cell — so a
        // product with a short title rendered a narrower card, and the square
        // image box shrank its height to match.
        const show = matchesSearch && currentlyShown < visibleLimit;
        if (show) currentlyShown++;
        card.classList.toggle('hidden', !show);
      });

      emptyEl?.classList.toggle('hidden', cards.length === 0 || matchedCount > 0);
      // "Menampilkan 0 dari 0" beside the empty message says nothing more.
      statusEl?.toggleAttribute('hidden', matchedCount === 0);
      if (visibleCountEl) visibleCountEl.textContent = String(currentlyShown);
      if (totalCountEl) totalCountEl.textContent = String(matchedCount);

      if (loadMoreBtn) {
        if (currentlyShown >= matchedCount) {
          loadMoreBtn.style.display = 'none';
        } else {
          loadMoreBtn.style.display = 'inline-flex';
        }
      }
    }

    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
      visibleLimit = 10;
      filterAndRender();
    });

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        currentCategory = chip.dataset.category ?? '';
        chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
        visibleLimit = 10;
        filterAndRender();
      }),
    );

    loadMoreBtn?.addEventListener('click', () => {
      visibleLimit += 10;
      filterAndRender();
    });

    filterAndRender();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductCatalog);
  } else {
    initProductCatalog();
  }
</script>

<style>
  .catalog-chips {
    scrollbar-width: none;
  }
  .catalog-chips::-webkit-scrollbar {
    display: none;
  }
</style>
