---

interface Slide {
  image: string;
  alt: string;
  badge: string;
  text: string;
}

interface Highlight {
  label: string;
  icon: string;
}
interface HeroContent {
  title: string;
  description: string;
  ratingLabel: string;
}

interface Props {
  slides: Slide[];
  highlights: Highlight[];
  content: HeroContent;
}

const { slides } = Astro.props;
---

<section class="px-4 pt-4">
  <h1 class="sr-only">{Astro.locals.tenant.defaultTitle}</h1>
  {/* Inset with a soft radius and the caption under the photo, not over it:
      no gradient to keep legible, and the slide reads as a card the buyer can
      flick through rather than a full-bleed poster. */}
  <div class="overflow-hidden rounded-2xl bg-[#F3F3F3]">
    <div id="hero-track" class="hero-track flex snap-x snap-mandatory overflow-x-auto">
      {
        slides.map((slide, index) => (
          <article class="min-w-full snap-start" aria-roledescription="slide" aria-label={`${index + 1} dari ${slides.length}`}>
            <img
              src={slide.image}
              alt={`${slide.alt} - ${Astro.locals.tenant.name}`}
              width="600"
              height="480"
              class="aspect-[5/4] w-full object-cover object-center"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding={index === 0 ? 'sync' : 'async'}
              fetchpriority={index === 0 ? 'high' : undefined}
              draggable={false}
            />
            <div class="bg-white px-1 pt-3">
              {slide.badge && <p class="text-xs font-medium text-[#767676]">{slide.badge}</p>}
              <p class="mt-0.5 line-clamp-2 text-base font-semibold leading-snug text-[#111111]">{slide.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
  {slides.length > 1 && (
    <div id="hero-dots" class="-mt-1 flex items-center justify-end">
      {
        slides.map((_, index) => (
          <button
            type="button"
            aria-label={`Tampilkan slide ${index + 1}`}
            aria-current={index === 0 ? 'true' : undefined}
            class="hero-dot group flex h-11 w-6 items-center justify-center focus-visible:outline-2 focus-visible:outline-[#111111]"
          >
            <span class="block h-1.5 w-1.5 rounded-full bg-[#D4D4D8] transition-all group-aria-[current=true]:w-4 group-aria-[current=true]:bg-[#111111]" />
          </button>
        ))
      }
    </div>
  )}
</section>

<style>
  .hero-track {
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .hero-track::-webkit-scrollbar {
    display: none;
  }
</style>
