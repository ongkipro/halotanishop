---
interface LandingPage {
  title: string;
  excerpt: string;
  href?: string;
  crop?: string;
}

interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  pages: LandingPage[];
  heading: Heading;
  /** The home page is a summary, not an index; the full list lives at /landing-page. */
  limit?: number;
}

const { pages, heading, limit = 5 } = Astro.props;
// Only the ones that go somewhere. A landing page with no href is a row the
// visitor can read but not open, which is worse than not listing it.
const linked = pages.filter((page) => Boolean(page.href));
const visible = linked.slice(0, limit);
const hasMore = linked.length > visible.length;
---

{
  linked.length > 0 && (
    <section id="halaman" class="px-4 py-6">
      <div class="mb-3">
        <h2 class="text-xl font-bold tracking-[-0.02em] text-[#111111]">{heading.title}</h2>
        {heading.description && <p class="mt-1 text-sm leading-6 text-[#555555]">{heading.description}</p>}
      </div>

      <ul class="flex flex-col overflow-hidden rounded-2xl bg-[#F3F3F3]">
        {visible.map((page) => (
          <li class="border-t border-white first:border-t-0">
            <a
              href={page.href}
              class="flex min-h-14 items-center justify-between gap-3 px-4 py-3 transition-colors hover:bg-[#EBEBED] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#111111]"
            >
              <span class="min-w-0">
                <span class="block truncate text-sm font-semibold text-[#111111]">{page.title}</span>
                <span class="mt-0.5 block truncate text-xs font-normal text-[#555555]">
                  {page.excerpt}
                </span>
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4 shrink-0 text-[#767676]"
                aria-hidden="true"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>

      {hasMore && (
        <a
          href="/landing-page"
          class="mt-3 inline-flex min-h-11 w-full items-center justify-center rounded-full border border-[#E5E5E5] bg-white px-6 text-sm font-semibold text-[#111111] transition-colors hover:border-[#111111] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111]"
        >
          Lihat semua halaman
        </a>
      )}
    </section>
  )
}
