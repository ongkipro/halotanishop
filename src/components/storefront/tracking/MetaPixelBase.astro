---
import { getStoreAdsConfig } from '../../../lib/store-ads';
import { META_EXTERNAL_ID_COOKIE } from '../../../lib/click-ids';

interface Props {
  pixelId?: string;
}

const { pixelId: pixelIdProp } = Astro.props;

let pixelId = pixelIdProp;
if (pixelId === undefined) {
  const adsConfig = await getStoreAdsConfig(Astro.locals);
  pixelId = adsConfig.metaPixelId;
}
const shouldRenderPixel = /^\d{5,25}$/.test(String(pixelId || '').trim());
---

{shouldRenderPixel && (
  <>
    {/* fbevents.js and the pixel config together cost roughly 220 KB from a
        third-party origin, and the connection is only opened once the inline
        loader runs. Warming DNS, TCP and TLS here removes that round trip from
        the critical path. Rendered only when a pixel is actually configured. */}
    <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />
    <script is:inline define:vars={{ pixelId, metaExternalIdCookie: META_EXTERNAL_ID_COOKIE }}>
      (() => {
        if (typeof window === 'undefined') return;

        const createEventId = (prefix) => `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
        const eventId = createEventId('pv');
        window.__META_PAGEVIEW_EVENT_ID__ = eventId;

        const readCookieValue = (name) =>
          document.cookie
            .split('; ')
            .find((row) => row.startsWith(`${name}=`))
            ?.split('=')[1] || '';
        // `_fbp` is minted by fbevents.js, which this component loads late (see
        // `loadPixel`). The server-side PageView/ViewContent fire at once, so a
        // first-time visitor's top-of-funnel CAPI events left without it: 31% of
        // PageView and 21% of ViewContent rows carried `fbp`, against 99% of
        // Purchase. Writing the cookie first, in Meta's own format, lets those
        // events carry it; fbevents.js keeps an existing `_fbp` rather than
        // replacing it. Client-side on purpose: the HTML stays cacheable.
        if (!/^fb\.\d\.\d{10,20}\..+$/.test(readCookieValue('_fbp'))) {
          try {
            const fbpSecurity = window.location.protocol === 'https:'
              ? 'SameSite=None; Secure'
              : 'SameSite=Lax';
            const fbpRandom = String(crypto.getRandomValues(new Uint32Array(1))[0]).padStart(10, '0');
            document.cookie =
              `_fbp=fb.1.${Date.now()}.${fbpRandom}; Path=/; Max-Age=${90 * 24 * 60 * 60}; ${fbpSecurity}`;
          } catch {
            // Without Web Crypto the pixel mints it later, as before.
          }
        }

        let externalId = readCookieValue(metaExternalIdCookie);
        if (!/^[a-f0-9]{32}$/.test(externalId)) {
          externalId = '';
          try {
            externalId = Array.from(crypto.getRandomValues(new Uint8Array(16)))
              .map((byte) => byte.toString(16).padStart(2, '0'))
              .join('');
          } catch {
            // Pixel and CAPI still carry fbp/fbc when Web Crypto is unavailable.
          }
          if (externalId) {
            const cookieSecurity = window.location.protocol === 'https:'
              ? 'SameSite=None; Secure'
              : 'SameSite=Lax';
            document.cookie =
              `${metaExternalIdCookie}=${externalId}; Path=/; Max-Age=${90 * 24 * 60 * 60}; ${cookieSecurity}`;
          }
        }

        // A promise, never an `await` here: everything below must run in this
        // tick. `MetaLandingTracker` fires during body parse, and
        // `build.inlineStylesheets: 'always'` leaves no render-blocking
        // stylesheet between it and this script, so an await before the stub
        // and the track hook exist lets the tracker find no `fbq` and drop its
        // browser ViewContent without a word.
        const externalIdHashReady = (async () => {
          if (!externalId) return undefined;
          try {
            const digest = await crypto.subtle.digest(
              'SHA-256',
              new TextEncoder().encode(externalId),
            );
            return Array.from(new Uint8Array(digest))
              .map((byte) => byte.toString(16).padStart(2, '0'))
              .join('');
          } catch {
            // Pixel and CAPI still carry fbp/fbc when Web Crypto is unavailable.
            return undefined;
          }
        })();

        // Meta's own stub queues every fbq() call until the script arrives, so
        // the queue is created now and the 105 KB download is deferred. The
        // events, their order and their event IDs are unchanged; only the
        // moment the network request happens moves off the critical path,
        // where it and the pixel config were costing about 520 KB on a product
        // page.
        (function (f) {
          if (f.fbq) return;
          const n = (f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          });
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = true;
          n.version = '2.0';
          n.queue = [];
        })(window);

        let requested = false;
        const loadPixel = () => {
          if (requested) return;
          requested = true;
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://connect.facebook.net/en_US/fbevents.js';
          document.head.appendChild(script);
        };
        // The same escape hatch the Google leg has carried since it was
        // deferred. A conversion must never wait on a timer: the stub queues
        // the call, but nothing is sent until the library arrives, and on
        // `/thanks` a buyer who reads the page and closes it never triggers
        // the interaction listeners. Measured on the real library, pulling the
        // download forward took the Purchase from 2522 ms to 45 ms.
        window.__PS_LOAD_META_PIXEL__ = loadPixel;

        // Whichever comes first. The interaction path covers anyone who stays;
        // the timeout covers a visitor who reads and leaves without touching
        // anything, so a bounce is still counted rather than traded away.
        for (const type of ['pointerdown', 'keydown', 'touchstart', 'scroll']) {
          window.addEventListener(type, loadPixel, { once: true, passive: true });
        }
        // A plain timer, deliberately. `requestIdleCallback` was tried first and
        // does not defer anything: its `timeout` is a ceiling, not a floor, so
        // on a page this light it fired at 245 ms and the download landed
        // almost exactly where it had been.
        window.setTimeout(loadPixel, 2500);

        window.__META_PIXEL_ID__ = pixelId;

        // `fbq('init', id, advancedMatching)` is honoured EXACTLY ONCE per
        // pixel id. A later init with more keys is not merged and not an
        // error — it is discarded in silence. Verified against the live
        // library: after a second init carrying ph/fn/ln/ct/st/zp/country,
        // `fbq.instance.pixelsByID[id].userData` still held only the
        // `{external_id}` the first call had set.
        //
        // Three call sites init'd behind this one — MetaThanksTracker,
        // form-hybrid, form-middle — so every advanced-matching object they
        // built and hashed was thrown away, and the browser leg of a Purchase
        // matched on one key where the server leg matched on eight. This
        // component now owns the single init, and a page with better matching
        // supplies it through `__PS_META_INIT__` instead of calling `fbq`.
        let initialised = false;
        // Resolves when the single init has been *issued*, which is a digest
        // later than `runInit` returning. fbq's stub queues by arrival order
        // and fbevents replays it in that order, discarding a `track` that
        // precedes the `init`: measured on the live library, track-then-init
        // sent zero beacons to facebook.com/tr and init-then-track sent one.
        let releaseInit;
        const pixelInitialised = new Promise((resolve) => {
          releaseInit = resolve;
        });
        const runInit = (advancedMatching) => {
          if (initialised) return false;
          initialised = true;
          void externalIdHashReady.then((externalIdHash) => {
            const matching = Object.assign({}, advancedMatching || {});
            if (externalIdHash && !matching.external_id) matching.external_id = externalIdHash;
            for (const key of Object.keys(matching)) {
              if (matching[key] === undefined || matching[key] === '') delete matching[key];
            }
            if (Object.keys(matching).length) window.fbq('init', pixelId, matching);
            else window.fbq('init', pixelId);
            window.fbq('track', 'PageView', {}, { eventID: eventId });
            releaseInit();
          });
          return true;
        };
        window.__PS_META_INIT__ = runInit;

        // The only way any other file reaches `fbq('track')`, so no caller can
        // overtake the init whatever order the document parses in.
        window.__PS_META_TRACK__ = (eventName, data, options) => {
          void pixelInitialised.then(() => {
            try {
              window.fbq('track', eventName, data, options);
            } catch (error) {
              console.error('meta-pixel-track', error);
            }
          });
        };

        if (window.__PS_META_AWAIT_MATCHING__ === true) {
          // The page declared it will supply matching (see `/thanks`, whose
          // Purchase keys are only known after `/api/order-status` answers).
          // The wait is bounded: a hung or failed fetch must cost the better
          // matching, never the PageView itself.
          window.setTimeout(runInit, 4000);
        } else {
          runInit();
        }
      })();
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${encodeURIComponent(pixelId)}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>
  </>
)}
