---
import Breadcrumb from './Breadcrumb.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  badge?: string;
  title: string;
  description: string;
  breadcrumbs?: BreadcrumbItem[];
}

// `badge` is still accepted so the six callers keep compiling, and no longer
// drawn: a small-capitals label above every title was the template's habit,
// not the reader's need (DESIGN-SYSTEM §2.3).
const { title, description, breadcrumbs = [] } = Astro.props;
---

{breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
<section class="bg-white px-4 pb-2 pt-4">
  <div class="mx-auto max-w-[480px]">
    <h1 class="text-2xl font-bold leading-tight tracking-[-0.02em] text-[#111111]">{title}</h1>
    <p class="mt-1.5 max-w-[32rem] text-sm leading-6 text-[#555555]">{description}</p>
  </div>
</section>
