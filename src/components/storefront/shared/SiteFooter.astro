---
const footerLegal = [
  // Four policies plus one way into the catalogue. Meta and Google both want a
  // reachable contact, privacy policy, terms, and a shipping/returns policy
  // before they will run a store's ads; the rest was footer weight. /tentang,
  // /disclaimer, /testimoni and the others still render, still sit in
  // sitemap.xml and can still be linked from anywhere - they just no longer
  // ride along on every page.
  { label: 'Produk', href: '/produk' },
  { label: 'Halaman', href: '/landing-page' },
  { label: 'Kontak', href: '/kontak' },
  { label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
  { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
  { label: 'Pengiriman & Retur', href: '/pengiriman' },
];
---

<footer class="mt-6 bg-[#F3F3F3] px-5 pb-10 pt-8 text-[#111111]">
  <p class="text-sm font-semibold">{Astro.locals.tenant.name}</p>
  <nav aria-label="Tautan footer" class="mt-3 grid grid-cols-2 gap-x-4 text-sm text-[#555555]">
    {
      footerLegal.map((item) => (
        <a
          href={item.href}
          class="inline-flex min-h-10 items-center underline-offset-4 hover:text-[#111111] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111]"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <p class="mt-6 text-xs text-[#555555]">© {new Date().getFullYear()} {Astro.locals.tenant.name}</p>
</footer>
