---

// The footer is the storefront's navigation (Paduka, 2026-11-01): the header
// carries the store name alone, so the catalogue and the landing pages are
// reached from here. Meta and Google both want a reachable contact, privacy
// policy, terms, and a shipping/returns policy before they will run a store's
// ads; those stay one tap away on every page. /tentang, /disclaimer,
// /testimoni and the others still render and sit in sitemap.xml.
//
// No per-visitor value and no database read: the footer is safe in the
// two-minute anonymous edge cache (ADR-029).
const storeName = Astro.locals.tenant.name.trim();
// Heavy capitals run about 0.66em a character; the name fills the footer's
// inner width (100cqi less its 2.5rem padding) at that rate, capped so a
// two-letter name does not tower over the links.
const watermarkSize = `min(calc((100cqi - 2.5rem) / ${(Math.max(storeName.length, 1) * 0.66).toFixed(2)}), 6rem)`;

const groups = [
  {
    title: 'Belanja',
    links: [
      { label: 'Semua produk', href: '/produk' },
      { label: 'Halaman', href: '/landing-page' },
    ],
  },
  {
    title: 'Bantuan',
    links: [
      { label: 'Kontak', href: '/kontak' },
      { label: 'Pengiriman & Retur', href: '/pengiriman' },
      { label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
      { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
    ],
  },
];

const path = Astro.url.pathname;
const linkClass =
  'inline-flex min-h-10 items-center text-sm text-[#444444] underline-offset-4 hover:text-[#111111] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111] aria-[current=page]:font-semibold aria-[current=page]:text-[#111111]';
---

<footer class="@container relative mt-6 overflow-hidden bg-white px-5 pb-10 pt-8 text-[#111111]">
  {/* White like the page, opened by the header's own hairline: a rule that
      fades at both ends (SiteHeader). */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,#E5E5E5_20%,#E5E5E5_80%,transparent)]"
  ></div>
  {/* The store's name as a faint watermark across the top (Paduka,
      2026-11-01), behind the links rather than above them. Sized from the name's length against the footer's own width
      (container units), never stretched: a short name sets large, a long one
      small, and the letters keep their shape. Decorative only. */}
  <p
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-5 top-4 select-none overflow-hidden whitespace-nowrap text-center font-black uppercase leading-none tracking-tight text-[#111111]/[0.07]"
    style={`font-size:${watermarkSize}`}
  >
    {storeName}
  </p>

  <nav aria-label="Tautan footer" class="relative grid grid-cols-2 gap-x-4">
    {
      groups.map((group) => (
        <div>
          <p class="text-[13px] font-bold uppercase tracking-[0.08em] text-[#111111]">{group.title}</p>
          <ul class="mt-1.5">
            {group.links.map((item) => (
              <li>
                <a href={item.href} class={linkClass} aria-current={path === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  {/* The store holds the copyright on its own site; ongki.pro is credited as
      the maker (Paduka, 2026-11-01). The address left the footer the same
      day; /kontak and the policy pages still carry it. */}
  <p class="relative mt-8 text-center text-xs text-[#767676]">
    © {new Date().getFullYear()} {Astro.locals.tenant.name} ·{' '}
    <a
      href="https://ongki.pro"
      target="_blank"
      rel="noopener"
      class="underline-offset-4 hover:text-[#111111] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111]"
    >ongki.pro</a>
  </p>
</footer>
