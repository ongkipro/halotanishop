---
import { cardImageSrc } from '../../../lib/image-derivative';

/** The card only counts these. Requiring the full variant shape made every
 *  caller carry fields the card never reads. */
interface ProductVariant {
  id?: string;
  label?: string;
  price?: number;
  comparePrice?: number;
}

interface Props {
  product: {
    slug: string;
    productName: string;
    heroImage: string;
    category: string;
    price: number;
    comparePrice?: number;
    variants: ProductVariant[];
  };
  formatPrice: (value: number) => string;
  /** Above-the-fold cards only. On /produk the first row is the page's LCP
   *  element, and a lazy LCP image is the one thing lazy-loading must never
   *  touch — under Slow 4G it spent 726ms of a 919ms LCP merely waiting to
   *  be requested. The homepage grid sits below the hero and stays lazy. */
  eager?: boolean;
}

const { product, formatPrice, eager = false } = Astro.props;
const comparePrice = product.comparePrice ?? 0;
const hasDiscount = comparePrice > product.price;
// "Mulai" only when the variants really differ in price; a card that says
// "from" over one price is hedging for nothing.
const hasRange = new Set(product.variants.map((variant) => variant.price).filter((price) => typeof price === 'number')).size > 1;
// The price sits right under the title (one or two lines, clamped), as in
// the Shopify theme; the cards still line up because the grid stretches each
// one to its row and the text block fills the rest.
const discountPercentage = hasDiscount
  ? Math.round((1 - product.price / comparePrice) * 100)
  : 0;
---

<article class="group h-full">
  <a
    href={`/produk/${product.slug}`}
    class="flex h-full flex-col rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111]"
  >
    <div class="relative aspect-square overflow-hidden rounded-xl bg-[#F3F3F3]">
      <img
        src={cardImageSrc(product.heroImage)}
        alt={`Foto produk ${product.productName}`}
        width="320"
        height="320"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
      {discountPercentage > 0 && (
        <span class="absolute left-2 top-2 rounded-full bg-[#334FB4] px-1.5 py-0.5 text-[11px] font-bold leading-4 text-white">
          -{discountPercentage}%
        </span>
      )}
    </div>

    <div class="flex flex-1 flex-col px-0.5 pt-2">
      <h2 class="line-clamp-2 text-sm leading-5 text-[#111111]" title={product.productName}>{product.productName}</h2>
      <p class="mt-0.5 flex flex-wrap items-baseline gap-x-1.5 leading-5">
        {hasRange && <span class="text-xs text-[#555555]">Mulai</span>}
        <span class="text-[15px] font-bold text-[#111111]">{formatPrice(product.price)}</span>
        {hasDiscount && <span class="text-xs text-[#767676] line-through">{formatPrice(comparePrice)}</span>}
      </p>
      {product.variants.length > 1 && <p class="mt-0.5 text-xs text-[#767676]">{product.variants.length} pilihan</p>}
    </div>
  </a>
</article>
